{
    "name": "mikegarde/partition",
    "authors": [
        {
            "name": "Mike Garde",
            "email": "mgarde@gmail.com"
        }
    ],
    "type": "library",
    "license": "GPL-3.0-or-later",
    "description": "Partition a set of values into equal sets or near equal sets.",
    "autoload": {
        "psr-4": {
            "partition\\": "src/"
        }
    },
    "require": {
        "php" : "^5.6|^7.4|^8.0",
        "dusank/knapsack": "^10.0"
    },
    "require-dev": {
        "phpunit/phpunit": "*"
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": [
            "phpunit"
        ],
        "test:coverage": [
            "phpunit --coverage-clover=tmp/clover.xml --coverage-filter=src"
        ],
        "test:report": [
            "phpunit --coverage-html=tmp/coverage --coverage-filter=src"
        ]
    }
}
